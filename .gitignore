# Replit
.cache/
.local/
database_backup.sql

# Database backup dumps must NEVER be committed.
# They contain production user data (PII) and authentication artifacts.
# All backup snapshots live in App Storage under backups/{dev,prod}/.
/backups/
backups/*.sql
backups/*.sql.gz
*.sql.bak

# Local DB backup snapshots (durable copies live in App Storage; never commit raw dumps to VCS).
# Scoped narrowly so Drizzle migration files under lib/db/migrations/*.sql are NOT ignored.
artifacts/api-server/backups/
/myimpact-db-backup-*.sql
/myimpact-db-backup-*.sql.gz
/myimpact-db-backup-*.sql.tar.gz
