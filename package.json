{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --filter \"./tests/**\" --if-present run typecheck",
    "size": "pnpm --filter @workspace/my-impact run build && node scripts/check-bundle-size.mjs",
    "size:check": "node scripts/check-bundle-size.mjs",
    "lhci": "pnpm --filter @workspace/my-impact run build && lhci autorun --config=lighthouserc.desktop.cjs",
    "lhci:mobile": "pnpm --filter @workspace/my-impact run build && lhci autorun --config=lighthouserc.mobile.cjs",
    "a11y": "pnpm --filter @workspace/my-impact run build && lhci autorun --config=lighthouserc.accessibility.cjs",
    "lhci:collect": "pnpm --filter @workspace/my-impact run build && lhci collect --config=lighthouserc.desktop.cjs",
    "lhci:assert": "lhci assert --config=lighthouserc.desktop.cjs",
    "lhci:open": "lhci open",
    "test:e2e": "E2E_MANAGED_SERVERS=1 E2E_TEST_MODE=1 pnpm --filter @workspace/e2e test",
    "test:e2e:headed": "E2E_MANAGED_SERVERS=1 E2E_TEST_MODE=1 pnpm --filter @workspace/e2e test:headed",
    "test:e2e:ui": "E2E_MANAGED_SERVERS=1 E2E_TEST_MODE=1 pnpm --filter @workspace/e2e test:ui",
    "test:e2e:sso": "pnpm --filter @workspace/sso-e2e test",
    "test:sw-e2e": "pnpm --filter @workspace/sw-e2e test"
  },
  "private": true,
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.21",
      "dompurify": "^3.4.13",
      "form-data@2": "^2.5.6",
      "form-data@4": "^4.0.6",
      "vite@7": "^7.3.5",
      "markdown-it": "^14.2.0",
      "linkify-it": "^5.0.1",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "@opentelemetry/core@2": "^2.8.0",
      "@babel/core@7": "^7.29.6",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "path-to-regexp": "8.4.0",
      "@tootallnate/once": "^3.0.1",
      "brace-expansion": "^5.0.12",
      "browserslist": "^4.29.0",
      "baseline-browser-mapping": "^2.11.25",
      "cookie": "^0.7.0",
      "esbuild": "^0.25.0",
      "lodash": "^4.18.0",
      "postcss": "^8.5.28",
      "nanoid@3": "^3.3.18",
      "nanoid@5": "^5.1.16",
      "ip-address": "^10.3.1",
      "tmp": "^0.2.6",
      "ws": "^8.20.1",
      "qs": "^6.16.0",
      "uuid": "14.0.0",
      "yaml": "^2.8.3",
      "fast-xml-builder": "^1.1.9",
      "fast-uri": "^4.1.3",
      "fflate": "^0.8.3",
      "lighthouse": "^13.4.1",
      "proxy-agent": "^8.0.2",
      "body-parser@1": ">=1.20.6",
      "body-parser@2": ">=2.3.0",
      "express>body-parser": ">=2.3.0"
    }
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.3.0",
    "stripe": "^22.1.0",
    "stripe-replit-sync": "^1.0.0"
  }
}
