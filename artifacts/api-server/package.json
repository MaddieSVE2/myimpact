{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx ./src/scripts/seed-demo.ts",
    "backup:db": "tsx ./src/scripts/backup-db.ts",
    "backup:scheduled": "tsx ./src/scripts/backup-db.ts --prune --keep 12 --notify",
    "backup:prod": "tsx ./src/scripts/backup-db.ts --target prod",
    "backup:fetch": "tsx ./src/scripts/fetch-backup.ts",
    "digest:send": "tsx ./src/scripts/send-monthly-digest.ts",
    "digest:scheduled": "tsx ./src/scripts/send-monthly-digest.ts --skip-recently-sent --notify",
    "onboarding:emails": "tsx ./src/scripts/onboarding-emails.ts",
    "calendar:sync": "tsx ./src/scripts/sync-calendars.ts",
    "calendar:scheduled": "tsx ./src/scripts/sync-calendars.ts --prune"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@react-pdf/renderer": "^4.3.2",
    "@types/react": "catalog:",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "react": "catalog:",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "tsx": "catalog:"
  }
}
