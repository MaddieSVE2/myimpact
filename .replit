ENABLE_DEMO_LOGIN = "true"

[userenv.development]

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002
