modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lighthouse"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api"

[[workflows.workflow]]
name = "e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "E2E_MANAGED_SERVERS=1 E2E_TEST_MODE=1 E2E_API_PORT=5000 E2E_WEB_PORT=3000 pnpm --filter @workspace/e2e exec playwright test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm -r --if-present run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lighthouse"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "rm -rf .lighthouseci && CHROME_PATH=/home/runner/workspace/.cache/ms-playwright/chromium-1217/chrome-linux64/chrome pnpm exec lhci autorun && rm -rf .lighthouseci && CHROME_PATH=/home/runner/workspace/.cache/ms-playwright/chromium-1217/chrome-linux64/chrome pnpm exec lhci autorun --config=lighthouserc.mobile.cjs"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm exec tsc -b lib/db lib/api-zod lib/api-client-react lib/integrations-openai-ai-server && pnpm --filter @workspace/api-server typecheck"

[[workflows.workflow]]
name = "typecheck-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
APP_URL = "https://myimpact.uk"
SENTRY_ENVIRONMENT = "production"
VITE_SENTRY_DSN = "https://4a0e2d9a7fd406309b5a8088a2f0afb2@o4511322265092096.ingest.de.sentry.io/4511322280886352"

[userenv.shared]
VAPID_PUBLIC_KEY = "BMaRbrf9t20ly7I2LvtHc6iy0MRx3aQfiQpKevvYf5oBSJ4PlVfLUYVh9OkCSe-3yP6wnlPbKu2rG67IAphflkw"
VAPID_PRIVATE_KEY = "gn_-NCfr65DIEaqttESoZG_eraGYZtM9T_iFdoJfge8"
